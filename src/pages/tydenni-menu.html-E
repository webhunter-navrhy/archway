{# {"id": "poledni", "out": "tydenni-menu/index.html", "title": "Polední menu — Archway restaurant, Hradec Králové", "desc": "Týdenní polední nabídka restaurace Archway na Velkém náměstí v Hradci Králové. Polévka je v ceně menu."} #}
{% extends 'base.html' %}
{% import 'macros.html' as m with context %}
{% block main %}
{% call m.page_head('Týdenní menu', tydenni_menu.title, tydenni_menu.from|dm ~ ' – ' ~ tydenni_menu.to|dm ~ ' · ' ~ tydenni_menu.note, 'polevka', 'Polévka z polední nabídky') %}
  <div class="phead__cta">
    <a class="btn btn--gold" href="tel:{{ site.phone|tel }}">Rezervace {{ site.phone }}</a>
    <p class="open-status" data-open-status>Otevírací doba</p>
  </div>
{% endcall %}
<section class="week">
  <div class="shell shell--narrow">
    {% for day in tydenni_menu.days %}
    <div class="week__day rv">{{ m.lunch_day(day) }}</div>
    {% endfor %}
    <p class="week__foot rv"><em>{{ tydenni_menu.footer }}</em> V ceně hlavního jídla je zahrnuta i polévka.</p>
  </div>
</section>
{% endblock %}
