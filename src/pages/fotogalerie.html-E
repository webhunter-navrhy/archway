{# {"id": "galerie", "out": "fotogalerie/index.html", "title": "Fotogalerie — Archway restaurant, Hradec Králové", "desc": "Fotografie jídel, sálu pod klenbou a posezení pod podloubím restaurace Archway na Velkém náměstí."} #}
{% extends 'base.html' %}
{% import 'macros.html' as m with context %}
{% block main %}
{% call m.page_head('Fotogalerie', 'Jídla, sál a podloubí', '', 'klenba', 'Sál s cihlovou klenbou') %}
  <p class="phead__lead">Další fotky přidáváme na <a class="ulink ulink--light" href="{{ site.instagram }}" target="_blank" rel="noopener">Instagram @{{ site.instagram_label }}</a> a <a class="ulink ulink--light" href="{{ site.facebook }}" target="_blank" rel="noopener">Facebook</a>.</p>
{% endcall %}
<section class="masonry-wrap">
  <div class="shell">
    <div class="masonry" data-lightbox>
      {% for p in galerie.photos %}
      <a class="masonry__item rv" href="{{ root }}{% if p.img.startswith('img/') %}{{ p.img }}{% else %}assets/img/{{ p.img }}-{{ '1600' if sizes[p.img][0] >= 1000 else '800' }}.webp{% endif %}" data-alt="{{ p.alt }}">{{ m.pic(p.img, p.alt, '(min-width: 1100px) 33vw, (min-width: 600px) 50vw, 100vw') }}</a>
      {% endfor %}
    </div>
  </div>
</section>
<dialog class="lightbox" data-lb>
  <img alt="">
  <p class="lightbox__cap"></p>
  <button type="button" class="lightbox__btn lightbox__prev" data-lb-prev aria-label="Předchozí">‹</button>
  <button type="button" class="lightbox__btn lightbox__next" data-lb-next aria-label="Další">›</button>
  <button type="button" class="lightbox__close" data-lb-close aria-label="Zavřít">×</button>
</dialog>
{% endblock %}
