{# {"id": "menu", "out": "menu/index.html", "title": "Jídelní lístek — Archway restaurant, Hradec Králové", "desc": "Jídelní lístek restaurace Archway: předkrmy, saláty, steaky z vyzrálého hovězího, ryby a dezerty. Česky i anglicky."} #}
{% extends 'base.html' %}
{% import 'macros.html' as m with context %}
{% block main %}
{% call m.page_head('Menu · À la carte', menu.title, '', 'filet-mignon', 'Filet mignon s batátovými hranolky') %}
  <p class="phead__lead"><span class="cs">Předkrmy, saláty, hlavní chody a dezerty. Ceny jsou uvedeny v Kč.</span><span class="en" lang="en">Starters, salads, main courses and desserts. Prices in CZK.</span></p>
{% endcall %}
<div class="mbar" data-mbar>
  <div class="shell mbar__in">
    <nav class="mbar__cats" aria-label="Kategorie">
      {% for cat in menu.categories %}<a href="#{{ cat.id }}" data-cat-link="{{ cat.id }}"><span class="cs">{{ cat.name }}</span><span class="en" lang="en">{{ cat.name_en }}</span></a>{% endfor %}
    </nav>
    <div class="lang" role="group" aria-label="Jazyk lístku">
      <button type="button" data-lang="cs" aria-pressed="true">CZ</button><button type="button" data-lang="en" aria-pressed="false">EN</button>
    </div>
  </div>
</div>
<section class="carte-full">
  <div class="shell shell--narrow">
    {% for cat in menu.categories %}
    <section class="mcat" id="{{ cat.id }}" data-cat="{{ cat.id }}">
      <h2 class="mcat__title rv"><span class="cs">{{ cat.name }}</span><span class="en" lang="en">{{ cat.name_en }}</span></h2>
      <ul class="mlist">
        {% for it in cat['items'] %}
        <li class="mitem rv{% if it.img %} mitem--img{% endif %}">
          {% if it.img %}<span class="mitem__img">{{ m.pic(it.img, it.name, '96px') }}</span>{% endif %}
          <div class="mitem__row">
            <h3 class="mitem__name"><span class="cs">{{ it.name }}</span><span class="en" lang="en">{{ it.name_en }}</span>{% if it.tag %} <span class="tag"><span class="cs">{{ it.tag }}</span><span class="en" lang="en">{{ it.tag_en }}</span></span>{% endif %}</h3>
            <span class="mitem__dots" aria-hidden="true"></span>
            <p class="mitem__price">{{ it.price|kc }}</p>
          </div>
          {% if it.desc %}<p class="mitem__desc"><span class="cs">{{ it.desc }}</span><span class="en" lang="en">{{ it.desc_en }}</span></p>{% endif %}
        </li>
        {% endfor %}
      </ul>
    </section>
    {% endfor %}
    <p class="week__foot rv"><em class="cs">{{ menu.footer }}</em><em class="en" lang="en">{{ menu.footer_en }}</em></p>
  </div>
</section>
{% endblock %}
